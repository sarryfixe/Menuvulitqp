    local elapsed = os.clock() - CTDStartedAt
    CTDTimer.Text = "Thời gian: " .. CTDFormatTime(elapsed)
    CTDFloatingTimer.Text = "REC " .. CTDFormatTime(elapsed)
    if os.clock() - CTDLastSample >= 0.18 then
        CTDLastSample = os.clock()
        local char = Player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if root then
            local move = humanoid and humanoid.MoveDirection or Vector3.zero
            local previous = CTDCurrentRecord.lastPosition
            if not previous or (root.Position - previous).Magnitude >= 0.25 then
                CTDAddEvent({kind = "move", position = root.Position, move = move})
                CTDCurrentRecord.lastPosition = root.Position
            end
        end
    end
end)

