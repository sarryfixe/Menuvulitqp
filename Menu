local function CTDCloneData(value, depth)
    depth = depth or 0
    if depth > 5 then return nil end
    local kind = typeof(value)
    if kind == "string" or kind == "number" or kind == "boolean" then return value end
    if type(value) ~= "table" then return nil end
    local result = {}
    for k, v in pairs(value) do
        if type(k) == "string" or type(k) == "number" then
            local safe = CTDCloneData(v, depth + 1)
            if safe ~= nil then result[k] = safe end
        end
    end
    return result
end

local function CTDEncodeHistory()
    local output = {}
    for _, record in ipairs(CTDHistory) do
        local saved = {
            name = tostring(record.name or "Ban ghi"),
            duration = tonumber(record.duration) or 0,
            pinned = record.pinned == true,
            events = {}
        }
        for _, event in ipairs(record.events or {}) do
            local item = {kind = event.kind, time = tonumber(event.time) or 0}
            if event.kind == "move" and typeof(event.position) == "Vector3" then
                item.position = {event.position.X, event.position.Y, event.position.Z}
                item.move = event.move and {event.move.X, event.move.Y, event.move.Z} or nil
            elseif event.kind == "key" then
                item.key = tostring(event.key or "")
                item.down = event.down == true
            elseif event.kind == "tap" then
                item.x = tonumber(event.x) or 0
                item.y = tonumber(event.y) or 0
                item.input = tostring(event.input or "Touch")
            elseif event.kind == "action" then
                item.action = tostring(event.action or "")
                item.data = CTDCloneData(event.data)
            end
            table.insert(saved.events, item)
        end
        table.insert(output, saved)
    end
    return output
end

local function CTDLoadPersistentData()
    if type(readfile) ~= "function" then return end
    local ok, raw = pcall(readfile, CTDDataFile)
    if not ok or type(raw) ~= "string" or raw == "" then return end
    local decodedOK, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOK or type(data) ~= "table" then return end

    if type(data.settings) == "table" then
        FlySpeed = math.clamp(math.floor(tonumber(data.settings.flySpeed) or 50), 1, 1000)
        WalkSpeedValue = math.clamp(math.floor(tonumber(data.settings.walkSpeed) or 50), 1, 1000)
        if type(data.settings.selectedTab) == "string" then CTDLoadedTab = data.settings.selectedTab end
        if type(data.settings.historyOpen) == "boolean" then CTDHistoryOpen = data.settings.historyOpen end
        if type(data.settings.menuX) == "number" and type(data.settings.menuY) == "number" then
            CTDOriginalPosition = UDim2.new(0.5, data.settings.menuX, 0.5, data.settings.menuY)
        end
    end

    if type(data.history) == "table" then
        for _, item in ipairs(data.history) do
            if #CTDHistory >= CTDMaxHistory then break end
            if type(item) == "table" and type(item.events) == "table" then
                local restored = {
                    name = tostring(item.name or ("Ban ghi " .. (#CTDHistory + 1))),
                    duration = tonumber(item.duration) or 0,
                    pinned = item.pinned == true,
                    events = {}
                }
                for _, event in ipairs(item.events) do
                    if type(event) == "table" then
                        local e = {kind = event.kind, time = tonumber(event.time) or 0}
                        if event.kind == "move" and type(event.position) == "table"
                            and tonumber(event.position[1]) and tonumber(event.position[2]) and tonumber(event.position[3]) then
                            e.position = Vector3.new(tonumber(event.position[1]), tonumber(event.position[2]), tonumber(event.position[3]))
                            if type(event.move) == "table" then
                                e.move = Vector3.new(tonumber(event.move[1]) or 0, tonumber(event.move[2]) or 0, tonumber(event.move[3]) or 0)
                            end
                        elseif event.kind == "key" and type(event.key) == "string" then
                            e.key, e.down = event.key, event.down == true
                        elseif event.kind == "tap" then
                            e.x, e.y, e.input = tonumber(event.x) or 0, tonumber(event.y) or 0, tostring(event.input or "Touch")
                        elseif event.kind == "action" and type(event.action) == "string" then
                            e.action, e.data = event.action, CTDCloneData(event.data)
                        end
                        if e.kind == "move" or e.kind == "key" or e.kind == "tap" or e.kind == "action" then
                            table.insert(restored.events, e)
                        end
                    end
                end
                if #restored.events > 0 then table.insert(CTDHistory, restored) end
            end
        end
    end
end

