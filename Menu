local function CTDLoadPersistentData()
    if type(readfile) ~= "function" then return end
    local ok, raw = pcall(readfile, CTDDataFile)
    if not ok or type(raw) ~= "string" or raw == "" then return end
    local decodedOK, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOK or type(data) ~= "table" then return end
    if type(data.settings) == "table" then
        FlySpeed = math.clamp(math.floor(tonumber(data.settings.flySpeed) or 50), 1, 1000)
        WalkSpeedValue = math.clamp(math.floor(tonumber(data.settings.walkSpeed) or 50), 1, 1000)
        if type(data.settings.selectedTab) == "string" then CTDLoadedTab = data.settings.selectedTab end
    end
    local macro = data.macro
    if type(macro) == "table" then
        CTDCurrentWave = math.clamp(math.floor(tonumber(macro.currentWave) or 1), 1, 50)
        if type(macro.completed) == "table" then
            for k, v in pairs(macro.completed) do
                local n = tonumber(k)
                if n and n >= 1 and n <= 50 and v == true then CTDCompleted[n] = true end
            end
        end
    end
end

SavePersistentData = function()
    if type(writefile) ~= "function" then return false end
    local completed = {}
    for wave, done in pairs(CTDCompleted) do
        if done then completed[tostring(wave)] = true end
    end
    local payload = {
        version = 4,
        settings = {flySpeed = FlySpeed, walkSpeed = WalkSpeedValue, selectedTab = CTDSelectedTab},
        macro = {currentWave = CTDCurrentWave, completed = completed}
    }
    return pcall(function() writefile(CTDDataFile, HttpService:JSONEncode(payload)) end)
end

