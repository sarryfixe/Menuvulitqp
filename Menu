-- Capture keyboard/touch/mouse input that reaches the game. UI input from this hub is ignored.
local function CTDPointInsideHub(point)
    local p, size = MainFrame.AbsolutePosition, MainFrame.AbsoluteSize
    if point.X >= p.X and point.X <= p.X + size.X and point.Y >= p.Y and point.Y <= p.Y + size.Y then return true end
    if ReopenButton and ReopenButton.Visible then
        local rp, rs = ReopenButton.AbsolutePosition, ReopenButton.AbsoluteSize
        if point.X >= rp.X and point.X <= rp.X + rs.X and point.Y >= rp.Y and point.Y <= rp.Y + rs.Y then return true end
    end
    return false
end

