--==================================================
-- GET CANDY POSITION
--==================================================

local function GetCandyPosition(candy)

    local rest = candy:GetAttribute("Rest")

    if typeof(rest) == "Instance"
        and rest:IsA("BasePart")
        and rest:IsDescendantOf(workspace) then

        return rest.Position, rest

    elseif typeof(rest) == "Vector3" then

        return rest, nil

    elseif typeof(rest) == "CFrame" then

        return rest.Position, nil
    end

    if candy:IsA("BasePart") then
        return candy.Position, candy

    elseif candy:IsA("Model") then
        return candy:GetPivot().Position, nil
    end

    local part = candy:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

    if part then
        return part.Position, part
    end

    return nil, nil
end

--==================================================
-- FIND CLOSEST CANDY
--==================================================

local function FindClosestCandy(root)

    local closestCandy = nil
    local closestPosition = nil
    local closestDistance = math.huge

    if not HalloweenFolder or not HalloweenFolder.Parent then
        return nil, nil
    end

    for _, candy in ipairs(HalloweenFolder:GetChildren()) do

        local position, part = GetCandyPosition(candy)

        if position then

            local distance =
                (root.Position - position).Magnitude

            if distance < closestDistance then

                closestDistance = distance
                closestCandy = candy
                closestPosition = position

            end
        end
    end

    return closestCandy, closestPosition
end

--==================================================
-- FIND CLOSEST DOOR
--==================================================

local function FindClosestDoor(root)

    local closestPrompt = nil
    local closestPart = nil
    local closestDistance = math.huge

    if not HalloweenTrees or not HalloweenTrees.Parent then
        return nil, nil
    end

    for _, tree in ipairs(HalloweenTrees:GetChildren()) do

        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")

        local prompt = frame and
            frame:FindFirstChild("TrickOrTreat")

        if prompt and prompt:IsA("ProximityPrompt") then

            local part = prompt.Parent

            if part and part:IsA("BasePart") then

                local distance =
                    (root.Position - part.Position).Magnitude

                if distance < closestDistance then

                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part

                end
            end
        end
    end

    return closestPrompt, closestPart
end

