    if not CTDCurrentRecord or #CTDCurrentRecord.events == 0 then
        CTDSetStatus("Chưa có dữ liệu để lưu", MUTED)
        return
    end
    local saved = {
        name = "Macro " .. tostring(os.date("%d-%m %H:%M:%S")),
        duration = CTDCurrentRecord.duration,
        pinned = false,
        events = CTDCurrentRecord.events
    }
    if #CTDHistory >= CTDMaxHistory then
        local removeIndex
        for i, item in ipairs(CTDHistory) do
            if not item.pinned then removeIndex = i break end
        end
        if not removeIndex then
            CTDSetStatus("Đủ 10 bản ghi đều đã ghim - bỏ ghim một bản trước", MUTED)
            return
        end
        table.remove(CTDHistory, removeIndex)
        if CTDSelectedIndex and CTDSelectedIndex > removeIndex then CTDSelectedIndex -= 1 end
    end
    table.insert(CTDHistory, saved)
    CTDSelectedIndex = #CTDHistory
    CTDCurrentRecord = nil
    CTDRefreshHistory()
    local persisted = SavePersistentData and SavePersistentData()
    CTDSetStatus(persisted and "Đã lưu macro và lịch sử vào thiết bị" or "Đã lưu trong phiên này; cần môi trường hỗ trợ file để giữ sau khi thoát", persisted and PURPLE or MUTED)
end)

local function CTDStopMacro()
    CTDMacroEnabled = false
    CTDPlayToken += 1
    CTDMacroButton.Text = "PHÁT: OFF"
    CTDMacroButton.BackgroundColor3 = CARD
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum:Move(Vector3.zero, false) end
end

local function CTDPlayRecord(record)
    if CTDRecording or not record then return end
    local char = Player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then CTDSetStatus("Không tìm thấy nhân vật", MUTED) return end
    CTDPlayToken += 1
    local token = CTDPlayToken
    CTDMacroEnabled = true
    CTDMacroButton.Text = "DỪNG PHÁT"
    CTDMacroButton.BackgroundColor3 = DARK_PURPLE
    CTDSetStatus("Đang phát: " .. record.name, PURPLE)
    task.spawn(function()
        local started = os.clock()
        local held = {}
        for _, event in ipairs(record.events) do
            if not CTDMacroEnabled or token ~= CTDPlayToken then break end
            local delayTime = event.time - (os.clock() - started)
            if delayTime > 0 then task.wait(delayTime) end
            if not CTDMacroEnabled or token ~= CTDPlayToken then break end
            local currentChar = Player.Character
            local currentHumanoid = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if event.kind == "move" and currentHumanoid and typeof(event.position) == "Vector3" then
                -- Use the recorded path for consistent movement replay in the same experience.
                currentHumanoid:MoveTo(event.position)
            elseif event.kind == "key" then
                held[event.key] = event.down and true or nil
                if event.key == "Space" and event.down and currentHumanoid then currentHumanoid.Jump = true end
            elseif event.kind == "action" then
                CTDPlayAction:Fire(event.action, CTDCloneData(event.data))
            elseif event.kind == "tap" then
                -- Roblox LocalScripts cannot synthesize a real touch/mouse click.
                -- The tap is retained in the macro; game-specific actions use CTD_RegisterAction.
                CTDPlayAction:Fire("CTD_TapMarker", {x = event.x, y = event.y, input = event.input})
            end
        end
        if token == CTDPlayToken then
            CTDStopMacro()
            CTDSetStatus("Phát lại hoàn tất (nút game cần đăng ký CTD action)", PURPLE)
        end
    end)
end

