--==================================================
-- START FARM
--==================================================

local function StartFarmCandy()

    if FarmCandyEnabled then
        return
    end

    FarmCandyEnabled = true

    FarmCandyButton.Text = "FARM CANDY: ON"
    FarmCandyButton.BackgroundColor3 = DARK_PURPLE

    if not HalloweenFolder or not HalloweenTrees then
        SetFarmStatus("Event folders not found - waiting...", MUTED)
    else
        SetFarmStatus("Finding candy...", PURPLE)
    end

    FarmCandyThread = task.spawn(function()

        while FarmCandyEnabled do

            local character = Player.Character

            local humanoid = character and
                character:FindFirstChildOfClass("Humanoid")

            local root = character and
                character:FindFirstChild("HumanoidRootPart")

            if not humanoid or not root
                or humanoid.Health <= 0 then

                SetFarmStatus(
                    "Waiting for character...",
                    MUTED
                )

                task.wait(0.5)
                continue
            end

            --======================================
            -- PRIORITY 1: CANDY
            --======================================

            local candy, position =
                FindClosestCandy(root)

            if candy and position then

                CandySpawned = false

                SetFarmStatus(
                    "Candy detected! Collecting...",
                    PURPLE
                )

                humanoid:MoveTo(
                    position + Vector3.new(0, 2, 0)
                )

                -- Scan frequently for newly spawned candy
                for i = 1, 5 do

                    if not FarmCandyEnabled then
                        break
                    end

                    task.wait(0.1)

                    if CandySpawned then
                        break
                    end
                end

                continue
            end

            --======================================
            -- PRIORITY 2: DOOR
            --======================================
               local prompt, part =
                FindClosestDoor(root)

            if prompt and part then

                SetFarmStatus(
                    "Visiting closest door...",
                    PURPLE
                )

                humanoid:MoveTo(part.Position)

                -- Keep checking for candy while approaching
                for i = 1, 10 do

                    if not FarmCandyEnabled then
                        break
                    end

                    task.wait(0.1)

                    if CandySpawned then
                        break
                    end
                end

                -- If no candy appeared, wait near the prompt
                if FarmCandyEnabled
                    and not CandySpawned
                    and (root.Position - part.Position).Magnitude
                        <= prompt.MaxActivationDistance then

                    SetFarmStatus(
                        "At door - waiting for prompt",
                        PURPLE
                    )
                end

            else

                SetFarmStatus(
                    "No candy - No doors found",
                    MUTED
                )

                task.wait(0.3)
            end
        end

    end)
end

